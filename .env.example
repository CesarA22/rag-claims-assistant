# fake | openai | chaos
# Default is fake: no API key, no network. Required for evaluators without a key.
LLM_PROVIDER=fake

# Required only when LLM_PROVIDER=openai (S5).
OPENAI_API_KEY=

# Chaos provider (S6). Ignored unless LLM_PROVIDER=chaos.
CHAOS_TIMEOUT_RATE=0
CHAOS_500_RATE=0
CHAOS_LATENCY_MS=0
