# fake | openai | chaos
# Default is fake: no API key, no network. Required for evaluators without a key.
LLM_PROVIDER=fake

DATABASE_URL=postgresql://insurco:insurco@localhost:5433/insurco
EMBED_MODEL=text-embedding-3-small

# memory | sql
STORAGE=memory

# memory | hybrid. memory is two fixed chunks spanning one product, so the
# ambiguity gate (gs-009) cannot fire against it. hybrid needs Postgres and an
# ingested corpus.
RETRIEVER=memory
# lexical | vector | hybrid. Ignored unless RETRIEVER=hybrid. lexical needs no
# API key; the vector arms embed every question.
RETRIEVER_ARM=lexical

# Required only when LLM_PROVIDER=openai, or on a cache miss during ingest.
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini

# Resilience — guesses production data would replace.
LLM_REQUEST_BUDGET_S=6.0
LLM_MIN_RETRY_BUDGET_S=1.5
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_S=0.25
LLM_BACKOFF_MAX_S=2.0
LLM_BREAKER_FAILURES=5
LLM_BREAKER_RESET_S=30.0
LLM_COST_CEILING_USD=0.05
LLM_MAX_OUTPUT_TOKENS=800
LLM_REASONING_EFFORT=none

# Confirmed against the pricing page. Reasoning tokens bill as output.
LLM_PRICE_INPUT_PER_M=0.75
LLM_PRICE_CACHED_INPUT_PER_M=0.075
LLM_PRICE_OUTPUT_PER_M=4.50

# Chaos provider. Ignored unless LLM_PROVIDER=chaos.
CHAOS_TIMEOUT_RATE=0
CHAOS_500_RATE=0
CHAOS_LATENCY_MS=0
# CHAOS_SEED=
