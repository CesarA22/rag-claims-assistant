# fake | openai | chaos
# Default is fake: no API key, no network. Required for evaluators without a key.
LLM_PROVIDER=fake

DATABASE_URL=postgresql://insurco:insurco@localhost:5433/insurco
EMBED_MODEL=text-embedding-3-small

# Required only when LLM_PROVIDER=openai (S5), or on a cache miss during ingest.
OPENAI_API_KEY=

# Chaos provider (S6). Ignored unless LLM_PROVIDER=chaos.
CHAOS_TIMEOUT_RATE=0
CHAOS_500_RATE=0
CHAOS_LATENCY_MS=0
