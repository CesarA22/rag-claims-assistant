%% InsurCo claims assistant — the pipeline AS BUILT.
%% S11 wired the claims tool. Step 3 is now two sources: a deterministic router
%% (app/services/claims_router.py) picks named queries from the question by
%% regex, and their rows are prepended to what the corpus retriever returns.
%% There is still no model tool-calling step — LLMProvider.complete has no
%% `tools` parameter, and the reasoning for choosing a router over a plan/execute
%% round trip is in DECISIONS.md. A diagram showing a step the code does not have
%% would be the most misleading artefact here.
%% ---
%% The gate ORDER below is the real one, and the dashed G4 is not decoration:
%% is_supported is unreachable whenever the evidence spans more than one product,
%% because is_ambiguous returns first. Both proposed repairs were measured live
%% and rejected — EVALS.md finding 1.
flowchart TB
    subgraph client["web/ — React + TypeScript + Vite"]
        UI["Chat · TurnCard · CitationList<br/>Composer · ConnectionBanner"]
        NORM["state.ts<br/>3 wire shapes → 7 UI states<br/><i>+ degraded, orthogonal to outcome</i>"]
        UI --- NORM
    end

    subgraph api["app/api — HTTP shape only"]
        POST["POST /conversations/{id}/messages"]
        GET["GET /conversations/{id}/messages"]
        HEALTH["GET /healthz"]
        ERR["errors.py<br/>RFC 9457 problem+json · trace_id<br/>no model, no prompt, no traceback"]
    end

    subgraph pipeline["app/services/ask.py — reads top to bottom"]
        direction TB
        P1["1 · repo.recent_messages<br/><i>excludes failed + pending</i>"]
        P2["2 · repo.begin_turn<br/><i>new | in_flight | replay</i><br/>failed re-opens"]
        P3["3 · claims_evidence + retriever.search<br/><i>database rows, then corpus</i>"]
        P4["4 · llm.complete(schema, strict)"]
        P5["5 · judge()"]
        P6["6 · repo.complete_turn"]
        P1 --> P2 --> P3 --> P4 --> P5 --> P6
    end

    subgraph gates["app/services/grounding.py — deterministic, never prompted"]
        direction TB
        G1["is_pii_request"]
        G2["is_ambiguous"]
        G3["validate_citations"]
        G4["is_supported<br/><i>unreachable when the evidence<br/>spans 2+ products</i>"]
        G1 --> G2 --> G3 --> G4
    end

    subgraph llm["app/llm — the provider is assumed to fail"]
        RES["resilient.py<br/>budget · retry 429/5xx/timeout only<br/>breaker · cost ceiling"]
        OAI["openai_provider.py<br/><i>the only SDK import</i>"]
        FAKE["fake.py"]
        CHAOS["chaos.py"]
        RES --> OAI & FAKE & CHAOS
    end

    subgraph data["storage + retrieval"]
        PG[("Postgres + pgvector<br/>chunks · messages · citations<br/>documents · conversations")]
        HYB["hybrid.py<br/>tsvector OR + IDF ⊕ cosine<br/>RRF k=15 · doc_role boost"]
        ING["ingest.py<br/>tables first · footnotes<br/>redact at ingest"]
        SQLR["sql.py<br/>UNIQUE(conversation_id,<br/>client_message_id)"]
    end

    subgraph tools["app/tools + app/services — the second source"]
        ROUTER["claims_router.py<br/>regex on SIN-/AP- ids + intent<br/><i>deterministic, no model call</i>"]
        TOOL["tools/claims.py<br/>6 named queries · read-only SQLite<br/>no join to policyholders"]
        ROUTER --> TOOL
    end

    subgraph degraded["provider down, evidence in hand"]
        DEG["excerpts_answer<br/><i>unless evidence_carries_pii<br/>→ refuse instead</i>"]
    end

    NORM -->|"/api proxy, same origin"| POST
    NORM --> GET
    NORM -->|"poll 5 s"| HEALTH
    POST --> P1
    P3 --> HYB --> PG
    P3 --> ROUTER
    TOOL -->|"Evidence(source_kind=claims)"| P3
    P4 --> RES
    P5 -.-> gates
    P4 -. "ProviderDegraded | CircuitOpen" .-> DEG
    DEG --> P6
    P2 --> SQLR --> PG
    P6 --> SQLR
    GET --> SQLR
    ING --> PG
    POST -. "typed error" .-> ERR

    classDef gap stroke-dasharray:6 4,stroke:#b45309,color:#92400e
    classDef det stroke:#047857
    class G4 gap
    class gates,G1,G2,G3,ROUTER,DEG det
